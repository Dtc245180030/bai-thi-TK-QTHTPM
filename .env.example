# Địa chỉ IP thật của máy chủ (Host IP)
SERVER_IP=192.168.28.128

# Cấu hình MySQL Database
MYSQL_ROOT_PASSWORD=root_secure_pass_2026
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=portfolio_secure_pass_2026

# Cấu hình kết nối cho Web App
DB_HOST=db
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=portfolio_secure_pass_2026

# Cấu hình phpMyAdmin
PMA_PORT=80
PMA_ABSOLUTE_URI=/pma/

# Cổng truy cập ngoài của Nginx Reverse Proxy
NGINX_PORT=80

# Cấu hình Hệ thống Giám sát (Monitoring: Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
